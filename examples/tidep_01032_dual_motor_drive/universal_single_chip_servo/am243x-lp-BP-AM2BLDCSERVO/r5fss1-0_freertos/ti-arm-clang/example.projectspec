<?xml version="1.0" encoding="UTF-8"?>
<projectSpec>
    <applicability>
        <when>
            <context
                deviceFamily="ARM"
                deviceId="Cortex R.AM2434_ALX"
            />
        </when>
    </applicability>

    <project
        title="EtherCAT-Connected Single-Chip Dual-Servo Motor Drive Reference Design"
        name = "universal_single_chip_servo_am243x-lp_r5fss1-0_freertos_ti-arm-clang"
        products="sysconfig:1.23.0;com.ti.MOTOR_CONTROL_SDK_AMXXX:2025.00.00.01;com.ti.INDUSTRIAL_COMMUNICATIONS_SDK_AMXXX:2025.00.00.01;com.ti.MCU_PLUS_SDK_AMXXX:07.03.00.01"
        configurations="
            Release,
            Debug,
        "
        connection="TIXDS110_Connection.xml"
        toolChain="TICLANG"
        cgtVersion="4.0.1"
        device="Cortex R.AM2434_ALX"
        deviceCore="MAIN_PULSAR_Cortex_R5_1_0"
        ignoreDefaultDeviceSettings="true"
        ignoreDefaultCCSSettings="true"
        endianness="little"
        outputFormat="ELF"
        outputType="executable"

        compilerBuildOptions="
            -I${CG_TOOL_ROOT}/include/c
            -I${MCU_PLUS_SDK_PATH}/source
            -I${MOTOR_CONTROL_SDK_PATH}/source
            -I${CG_TOOL_ROOT}/include/c
            -I${IND_COMMS_SDK_PATH}/source
            -I${MCU_PLUS_SDK_PATH}/source/kernel/freertos/FreeRTOS-Kernel/include
            -I${MCU_PLUS_SDK_PATH}/source/kernel/freertos/portable/TI_ARM_CLANG/ARM_CR5F
            -I${MCU_PLUS_SDK_PATH}/source/kernel/freertos/config/am243x/r5f
            -I${IND_COMMS_SDK_PATH}/examples/industrial_comms/ethercat_subdevice_demo/device_profiles/402_cia
            -I${IND_COMMS_SDK_PATH}/examples/industrial_comms/ethercat_subdevice_demo/common
            -I${IND_COMMS_SDK_PATH}/examples/industrial_comms/ethercat_subdevice_demo/common/os
            -I${IND_COMMS_SDK_PATH}/examples/industrial_comms/ethercat_subdevice_demo/common/os/freertos
            -I${IND_COMMS_SDK_PATH}/examples/industrial_comms/ethercat_subdevice_demo/common/board/am243x-lp
            -I${IND_COMMS_SDK_PATH}/examples/industrial_comms/ethercat_subdevice_demo/common/board/am243x-lp/freertos
            -I${IND_COMMS_SDK_PATH}/examples/industrial_comms/custom_phy/inc
            -I${IND_COMMS_SDK_PATH}/examples/industrial_comms/nvm/app/inc
            -I${IND_COMMS_SDK_PATH}/examples/industrial_comms/nvm/drv/inc
            -I${IND_COMMS_SDK_PATH}/source/industrial_comms/ethercat_subdevice/stack/inc
            -I${IND_COMMS_SDK_PATH}/source/industrial_comms/ethercat_subdevice/stack/inc/defines
            -I${IND_COMMS_SDK_PATH}/source/industrial_comms/ethercat_subdevice/stack/inc/ext
            -I${IND_COMMS_SDK_PATH}/source/industrial_comms/ethercat_subdevice/stack/inc/profiles
            -I${IND_COMMS_SDK_PATH}/source/industrial_comms/common/inc
            -mcpu=cortex-r5
            -mfloat-abi=hard
            -mfpu=vfpv3-d16
            -mthumb
            -Wall
            -Werror
            -g
            -Wno-gnu-variable-sized-type-not-at-end
            -Wno-unused-function
            -Wno-unused-but-set-variable
            -DSOC_AM243X
            -DSOC_AM243X=1
            -DOSAL_FREERTOS=1
            -Dcore0
            -Dam243x
            -Dam243x_lp
            -DSSC_CHECKTIMER=1
            -DUSE_ECAT_TIMER=1
            -DCUST_PHY_DP83869=1
            -DOS_FREERTOS
            -DENABLE_TIDEP01032_REF_DESIGN_CONFIG
        "
        linkerBuildOptions="
            -i${CG_TOOL_ROOT}/lib
            -i${MCU_PLUS_SDK_PATH}/source/kernel/freertos/lib
            -i${MCU_PLUS_SDK_PATH}/source/drivers/lib
            -i${MCU_PLUS_SDK_PATH}/source/board/lib
            -i${IND_COMMS_SDK_PATH}/source/industrial_comms/ethercat_subdevice/stack/lib
            -i${CG_TOOL_ROOT}/lib
            -m=universal_single_chip_servo_am243x-lp_r5fss1-0_freertos_ti-arm-clang.${ConfigName}.map
            --diag_suppress=10063
            --ram_model
            --reread_libs
            --gen_xml_func_hash
            --use_memcpy=fast
            --use_memset=fast
        "

        postBuildStep="$(MAKE) -C ${CCS_PROJECT_DIR} -f makefile_ccs_bootimage_gen OUTNAME=${BuildArtifactFileBaseName} PROFILE=${ConfigName} MOTOR_CONTROL_SDK_PATH=${MOTOR_CONTROL_SDK_PATH} MCU_PLUS_SDK_PATH=${MCU_PLUS_SDK_PATH} CG_TOOL_ROOT=${CG_TOOL_ROOT} CCS_INSTALL_DIR=${CCS_INSTALL_DIR} CCS_IDE_MODE=${CCS_IDE_MODE} DEVICE=am243x"

        enableSysConfigTool="true"
        sysConfigBuildOptions="
            --context r5fss1-0 --part ALX --package ALX
        "

        description="A Universal Single Chip Servo FREERTOS project">

        <configuration name="Release"
            compilerBuildOptions="
                -Os
            "
            linkerBuildOptions="
                -llibc.a
                -llibsysbm.a
                -lfreertos.am243x.r5f.ti-arm-clang.release.lib
                -ldrivers.am243x.r5f.ti-arm-clang.freertos.release.lib
                -lboard.am243x.r5f.ti-arm-clang.freertos.release.lib
                -lethercat_subdevice.am243x_lp.r5f.ti-arm-clang.release.lib
                -lethercat_subdevice_bkhf_ssc.am243x_lp.r5f.ti-arm-clang.release.lib
                -llibc.a
                -llibsysbm.a
            "
        ></configuration>
        <configuration name="Debug"
            compilerBuildOptions="
                -D_DEBUG_=1
                -O0
            "
            linkerBuildOptions="
                -llibc.a
                -llibsysbm.a
                -lfreertos.am243x.r5f.ti-arm-clang.debug.lib
                -ldrivers.am243x.r5f.ti-arm-clang.freertos.debug.lib
                -lboard.am243x.r5f.ti-arm-clang.freertos.debug.lib
                -lethercat_subdevice.am243x_lp.r5f.ti-arm-clang.release.lib
                -lethercat_subdevice_bkhf_ssc.am243x_lp.r5f.ti-arm-clang.release.lib
                -llibc.a
                -llibsysbm.a
            "
        ></configuration>
        <pathVariable name="IND_COMMS_SDK_PATH" path="${COM_TI_INDUSTRIAL_COMMUNICATIONS_SDK_AMXXX_INSTALL_DIR}" scope="project" />
        <pathVariable name="MCU_PLUS_SDK_PATH" path="${COM_TI_MCU_PLUS_SDK_AMXXX_INSTALL_DIR}" scope="project" />        
        <pathVariable name="MOTOR_CONTROL_SDK_PATH" path="${COM_TI_MOTOR_CONTROL_SDK_AMXXX_INSTALL_DIR}" scope="project" />
        <file path="${IND_COMMS_SDK_PATH}/examples/industrial_comms/ethercat_subdevice_demo/common/ESL_version.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="${IND_COMMS_SDK_PATH}/examples/industrial_comms/ethercat_subdevice_demo/common/os/freertos/ESL_OS_os.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="${IND_COMMS_SDK_PATH}//examples/industrial_comms/ethercat_subdevice_demo/common/os/freertos/ESL_eeprom.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="${IND_COMMS_SDK_PATH}/examples/industrial_comms/ethercat_subdevice_demo/common/os/freertos/ESL_fileHandling.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="${IND_COMMS_SDK_PATH}/examples/industrial_comms/ethercat_subdevice_demo/common/os/freertos/ESL_foeDemo.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="${IND_COMMS_SDK_PATH}/examples/industrial_comms/ethercat_subdevice_demo/common/os/freertos/ESL_soeDemo.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="${IND_COMMS_SDK_PATH}/examples/industrial_comms/ethercat_subdevice_demo/common/os/freertos/ESL_gpioHelper.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="${IND_COMMS_SDK_PATH}/examples/industrial_comms/custom_phy/src/CUST_PHY_base.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="${IND_COMMS_SDK_PATH}/examples/industrial_comms/custom_phy/src/CUST_PHY_dp83869.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="${IND_COMMS_SDK_PATH}/examples/industrial_comms/ethercat_subdevice_demo/device_profiles/402_cia/ecSubDeviceCiA402.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="${IND_COMMS_SDK_PATH}/examples/industrial_comms/ethercat_subdevice_demo/device_profiles/402_cia/ESL_cia402Obd.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="${IND_COMMS_SDK_PATH}/examples/industrial_comms/ethercat_subdevice_demo/device_profiles/402_cia/EtherCAT_SubDevice_CiA402.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="${IND_COMMS_SDK_PATH}/examples/industrial_comms/ethercat_subdevice_demo/device_profiles/402_cia/ESL_cia402Demo.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="${IND_COMMS_SDK_PATH}/examples/industrial_comms/ethercat_subdevice_demo/common/board/am243x-lp/freertos/ESL_BOARD_OS_config.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="${IND_COMMS_SDK_PATH}/examples/industrial_comms/nvm/app/src/nvm.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="${IND_COMMS_SDK_PATH}/examples/industrial_comms/nvm/drv/src/nvm_drv_eeprom.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="${IND_COMMS_SDK_PATH}/examples/industrial_comms/nvm/drv/src/nvm_drv_flash.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../example.syscfg" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="${MOTOR_CONTROL_SDK_PATH}/docs/api_guide_am243x/EXAMPLE_TIDEP_01032_REFERENCE_DESIGN.html"
                openOnCreation="false" excludeFromBuild="false" targetName="README.html" action="link">
        </file>
        <file path="../project.h" openOnCreation="false" excludeFromBuild="true" action="copy">
        </file>
        <file path="../version.h" openOnCreation="false" excludeFromBuild="true" action="copy">
        </file>
        <file path="syscfg_c.rov.xs" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="makefile_ccs_bootimage_gen" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="makefile.defs" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
    </project>
</projectSpec>
