%%{
    isDevelopmentMode = args.common.isDevelopmentMode();
    deviceName = args.utils.getProjectSpecDevice(args.device);

    // Get device-specific versions using common functions
    const toolVersions = args.common.getToolVersions(args.device);
%%}

DEVICE ?= am243x

ifeq ($(OS),Windows_NT)
    TOOLS_PATH?=C:/ti
    CCS_PATH?=$(TOOLS_PATH)/`toolVersions.ccsVersion`/ccs
    CCS_ECLIPSE=$(CCS_PATH)/eclipse/eclipsec
    CYGWIN_PATH?=$(CCS_PATH)/utils/cygwin
    MKDIR=$(CYGWIN_PATH)/mkdir -p
    RMDIR=$(CYGWIN_PATH)/rm -rf
    RM=$(CYGWIN_PATH)/rm -f
    COPY=$(CYGWIN_PATH)/cp
    MOVE=$(CYGWIN_PATH)/mv
    CAT=$(CYGWIN_PATH)/cat
    SED=$(CYGWIN_PATH)/sed
    TOUCH=$(CYGWIN_PATH)/touch
    PATHSEP=\\
    CHMOD=$(CYGWIN_PATH)/echo
    SHELL=cmd.exe
% if((args.device == "am64x") || (isDevelopmentMode)) {
    CGT_GCC_AARCH64_PATH=$(TOOLS_PATH)/`toolVersions.gccAarch64WinVersion`
% }
% if((args.device == "am64x") || (args.device == "am243x") || (isDevelopmentMode)) {
    CGT_GCC_ARM_PATH=$(TOOLS_PATH)/`toolVersions.gccArmWinVersion`
    CGT_GCC_ARMV7_PATH=$(CGT_GCC_ARM_PATH)
% }
else
    UNAME_S := $(shell uname -s)
    ifneq (,$(filter $(UNAME_S),Linux Darwin))
        export TOOLS_PATH?=$(HOME)/ti
        export CCS_PATH?=$(TOOLS_PATH)/`toolVersions.ccsVersion`/ccs
        export CCS_ECLIPSE=$(CCS_PATH)/eclipse/eclipse
        export MKDIR=mkdir -p
        export RMDIR=rm -rf
        export RM=rm -f
        export COPY=cp
        export MOVE=mv
        export CAT=cat
        export SED=sed
        export TOUCH=touch
        export PATHSEP=/
        export CHMOD=chmod
% if((args.device == "am64x") || (isDevelopmentMode)) {
        CGT_GCC_AARCH64_PATH=$(TOOLS_PATH)/`toolVersions.gccAarch64LinuxVersion`
% }
% if((args.device == "am64x") || (args.device == "am243x") || (isDevelopmentMode)) {
        CGT_GCC_ARM_PATH=$(TOOLS_PATH)/`toolVersions.gccArmLinuxVersion`
        CGT_GCC_ARMV7_PATH=$(CGT_GCC_ARM_PATH)
% }
    endif
endif

CGT_TI_PRU_PATH=$(TOOLS_PATH)/`toolVersions.cgtPruVersion`
CGT_TI_ARM_CLANG_PATH=$(CCS_PATH)/tools/compiler/`toolVersions.cgtArmClangVersion`
ifeq ($(wildcard $(CGT_TI_ARM_CLANG_PATH)),)
    CGT_TI_ARM_CLANG_PATH=$(TOOLS_PATH)/`toolVersions.cgtArmClangVersion`
endif
% if((args.device == "am273x") || (args.device == "awr294x") || (isDevelopmentMode)) {
CGT_TI_C6000_PATH=$(CCS_PATH)/tools/compiler/`toolVersions.cgtC6000Version`
ifeq ($(wildcard $(CGT_TI_C6000_PATH)),)
    CGT_TI_C6000_PATH=$(TOOLS_PATH)/`toolVersions.cgtC6000Version`
endif
DSPLIB_PATH=$(MOTOR_CONTROL_SDK_PATH)/mcu_plus_sdk/source/`toolVersions.dsplibVersion`
% }
CCS_NODE = $(CCS_PATH)/tools/node/node
SYSCFG_PATH ?= $(TOOLS_PATH)/`toolVersions.sysconfigVersion`
SYSCFG_CLI_PATH ?= $(SYSCFG_PATH)
SYSCFG_NODE = $(SYSCFG_PATH)/nodejs/node
SYSCFG_NWJS = $(SYSCFG_PATH)/nw/nw
SYSCFG_SDKPRODUCT=$(MOTOR_CONTROL_SDK_PATH)/.metadata/product.json
OPTISHARE = $(CCS_NODE) $(CGT_TI_ARM_CLANG_PATH)/opti-share/opti-share.js
OPTISAVE = $(CCS_NODE) $(CGT_TI_ARM_CLANG_PATH)/opti-share/utils/opti-save.js