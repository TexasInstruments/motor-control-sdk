
all:
	$(MAKE) -f makefile.am243x libs
	$(MAKE) -f makefile.am243x examples

clean: libs-clean examples-clean
scrub: libs-scrub examples-scrub

help:
	@echo  Notes,
	@echo  - Use -j to invoke parallel builds
	@echo  - Use PROFILE=debug or PROFILE=release [default] to build in debug or release profile
	@echo  .
	@echo  Overall build targets,
	@echo  ======================
	@echo  $(MAKE) -s -f makefile.am243x help
	@echo  .
	@echo  $(MAKE) -s -f makefile.am243x all
	@echo  $(MAKE) -s -f makefile.am243x clean  # delete's tmp files for current profile
	@echo  $(MAKE) -s -f makefile.am243x scrub  # delete's all tmp files and folders for all profiles
	@echo  .
	@echo  $(MAKE) -s -f makefile.am243x libs
	@echo  $(MAKE) -s -f makefile.am243x libs-clean # delete's tmp files for current profile
	@echo  $(MAKE) -s -f makefile.am243x libs-scrub # delete's all tmp files and folders for all profiles
	@echo  .
	@echo  $(MAKE) -s -f makefile.am243x examples
	@echo  $(MAKE) -s -f makefile.am243x examples-clean # delete's tmp files for current profile
	@echo  $(MAKE) -s -f makefile.am243x examples-scrub # delete's all tmp files and folders for all profiles
	@echo  .
