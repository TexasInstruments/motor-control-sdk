
export MOTOR_CONTROL_SDK_PATH?=$(abspath ../../../../../../../..)
include $(MOTOR_CONTROL_SDK_PATH)/imports.mak

PROFILE?=Release

PROJECT_NAME=endat3_peripheral_interface_single_channel_am243x-lp_icss_g0_rtu_pru0_fw_ti-pru-cgt

all:
	$(CCS_ECLIPSE) -workspace $(MOTOR_CONTROL_SDK_PATH)/ccs_projects -application com.ti.ccs.apps.projectBuild -ccs.projects $(PROJECT_NAME) -ccs.configuration $(PROFILE)

clean:
	$(CCS_ECLIPSE) -workspace $(MOTOR_CONTROL_SDK_PATH)/ccs_projects -application com.ti.ccs.apps.projectBuild -ccs.projects $(PROJECT_NAME) -ccs.configuration $(PROFILE) -ccs.clean

export:
	$(MKDIR) $(MOTOR_CONTROL_SDK_PATH)/ccs_projects
	$(CCS_ECLIPSE) -workspace $(MOTOR_CONTROL_SDK_PATH)/ccs_projects -application com.ti.ccs.apps.projectCreate -ccs.projectSpec example.projectspec -ccs.overwrite full
