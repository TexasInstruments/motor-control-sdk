%%{
    let module = system.modules[args[0]];
%%}
/*
 * BiSS-C
 */

#include <position_sense/bissc/include/bissc_api.h>

/* BiSS-C Instance Macros */
#define CONFIG_BISSC_NUM_INSTANCES               (`module.$instances.length`U)
% for(let i = 0; i < module.$instances.length; i++) {
    % let instance = module.$instances[i];

#define `instance.$name.toUpperCase()`                                    (`i`)
#define `instance.$name.toUpperCase()`_BOOSTER_PACK_ENABLE                (`instance.Booster_Pack & 1`)
 %if ((instance.instance === "ICSSG1" || instance.instance === "ICSSG0") && (instance.G_MUX_EN))
    %{
#define `instance.$name.toUpperCase()`_G_MUX_EN                           (`instance["G_MUX_EN"] & 1`)
    %}
    % /* Calculate mode based on channel configuration and load share (for compile-time firmware selection) */
    % let mode = "BISSC_MODE_SINGLE_CHANNEL_SINGLE_PRU";  /* Default: BISSC_MODE_SINGLE_CHANNEL_SINGLE_PRU */
    % /* Check if multiple channels are enabled */
    % if(((instance.channel_0 & 1) && (instance.channel_1 & 1)) || ((instance.channel_1 & 1) && (instance.channel_2 & 1)) || ((instance.channel_2 & 1) && (instance.channel_0 & 1))) {
        % mode = "BISSC_MODE_MULTI_CHANNEL_SINGLE_PRU";  /* BISSC_MODE_MULTI_CHANNEL_SINGLE_PRU */
    % }
    % /* Load share mode overrides multi-channel mode */
    % if(instance.Multi_Channel_Load_Share & 1) {
        % mode = "BISSC_MODE_MULTI_CHANNEL_MULTI_PRU";  /* BISSC_MODE_MULTI_CHANNEL_MULTI_PRU */
    % }
    % /* Determine PRU-ICSS Slice (0 or 1) */
    % let pruicss_slice = 1;  /* Default to PRU1 */
    % if(instance.instance === "ICSSG0") {
        % if(instance.PRU_ICSSG0_PRU.$assign === "PRU_ICSSG0_PRU0") {
            % pruicss_slice = 0;
        % }
    % } else if(instance.instance === "ICSSG1") {
        % if(instance.PRU_ICSSG1_PRU.$assign === "PRU_ICSSG1_PRU0") {
            % pruicss_slice = 0;
        % }
    % } else {
        % /* For ICSSM, use pruicss_slice configuration */
        % pruicss_slice = (instance.PRU_Slice == "PRU1") ? 1 : 0;
    % }
#define `instance.$name.toUpperCase()`_MODE                               (`mode`)
    % let pruicss_instance = 0;
    % /* Determine ICSS type and instance index */
    % if(instance.instance === "ICSSM" || instance.instance === "ICSSM0" || instance.instance === "ICSSM1") {
        % if(instance.instance === "ICSSM1") {
            % pruicss_instance = 1;
        % }
    % } else {
        % if(instance.instance === "ICSSG1") {
            % pruicss_instance = 1;
        % }
    % }
#define `instance.$name.toUpperCase()`_PRUICSS_INSTANCE                   (`pruicss_instance`)
#define `instance.$name.toUpperCase()`_PRUICSS_SLICE                      (`pruicss_slice`)
    % /* Calculate individual channel enabled flags */
    % let channel0_enabled = (instance.channel_0 & 1);
    % let channel1_enabled = (instance.channel_1 & 1);
    % let channel2_enabled = (instance.channel_2 & 1);
#define `instance.$name.toUpperCase()`_CHANNEL0_ENABLED                   (`channel0_enabled`)
#define `instance.$name.toUpperCase()`_CHANNEL1_ENABLED                   (`channel1_enabled`)
#define `instance.$name.toUpperCase()`_CHANNEL2_ENABLED                   (`channel2_enabled`)
% }