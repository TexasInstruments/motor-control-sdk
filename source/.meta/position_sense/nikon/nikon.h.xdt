%%{
    let module = system.modules[args[0]];
%%}
/*
 * Nikon
 */

/* Nikon Instance Macros */
#define CONFIG_NIKON_NUM_INSTANCES               `module.$instances.length`
% for(let i = 0; i < module.$instances.length; i++) {
    % let instance = module.$instances[i];
    % let Mode = 0;
    % let sliceVal = 1;
    % let rtuPru = 3;
    % let txPru = 5;
    % let icssValue = 0;
    % if(instance.instance === "ICSSG0")
    % {
        % if(instance.PRU_ICSSG0_PRU.$assign === "PRU_ICSSG0_PRU0")
        % {
            % sliceVal = 0;
        % }
    % }
    % else if(instance.instance === "ICSSG1")
    % {
        % icssValue = 1;
        % if(instance.PRU_ICSSG1_PRU.$assign === "PRU_ICSSG1_PRU0")
        % {
            % sliceVal = 0;
        % }
    % }
     /*Macro for am263x/am261x */
    % if(instance.instance === "ICSSM" || instance.instance === "ICSSM0" || instance.instance === "ICSSM1")
    % {
        % if(instance.PRU_Slice == "PRU0")
        % {
            % sliceVal = 0;
        % }
#define PRUICSSM
         % if(instance.instance === "ICSSM1")
        % {
            %  icssValue = 1;
        % }

    % }
    %if(!(sliceVal & 1))
    %{
        % rtuPru = 2;
        % txPru = 4;
    %}
    %if(((instance.channel_0 & 1)&&(instance.channel_1 & 1))||((instance.channel_1 & 1)&&(instance.channel_2 & 1))||((instance.channel_2 & 1)&&(instance.channel_0 & 1)))
    %{
        % Mode = 1;
    %}
    %if(instance.Multi_Channel_Load_Share & 1)
    %{
        % Mode = 2;
    %}

#define `instance.$name`                  (`i`)
#define `instance.$name`_CHANNEL0         (`instance.channel_0 & 1`)
#define `instance.$name`_CHANNEL1         (`instance.channel_1 & 1`)
#define `instance.$name`_CHANNEL2         (`instance.channel_2 & 1`)
#define `instance.$name`_BAUDRATE         (`instance.baudrate`)
#define `instance.$name`_LOAD_SHARE_MODE  `instance.Multi_Channel_Load_Share & 1`
#define `instance.$name`_MODE             `Mode`
#define `instance.$name`_BOOSTER_PACK     (`instance.Booster_Pack & 1`)
#define `instance.$name`_PRUICSS_PRUx                      (`sliceVal`)
#define `instance.$name`_PRUICSSx                          (`icssValue`)
#define `instance.$name`_PRUICSS_TXPRUx                    (`txPru`)
#define `instance.$name`_PRUICSS_RTUPRUx                   (`rtuPru`)
#define `instance.$name`_TX_RX_FIFO_CLOCK_SOURCE           (`instance.Tx_Rx_Clk_Source`)
%if ((instance.instance === "ICSSG1" || instance.instance === "ICSSG0") && (instance.G_MUX_EN))
    %{
#define `instance.$name`_G_MUX_EN          `instance["G_MUX_EN"] & 1`
    %}
%if (instance.protocolVersion === 2.1)
    %{
#define `instance.$name`_PROTOCOL_VERSION             (NIKON_PROTOCOL_V2_1)
    %}
%if (instance.protocolVersion === 3.0)
    %{
#define `instance.$name`_PROTOCOL_VERSION             (NIKON_PROTOCOL_V3_0)
    %}
% }
