%%{
    let module = system.modules[args[0]];
%%}
/*
 * SDFM
 */

%if(module)
%{
#include <current_sense/sdfm/include/sdfm_drv.h>

/* SDFM attributes (compile-time data only) */
static SDFM_Attrs gSdfmAttrs[CONFIG_SDFM_NUM_INSTANCES] =
{
%for(let i = 0; i < module.$instances.length; i++) {
    % let instance = module.$instances[i];
    % /* Determine PRUICSS instance (0 for ICSSG0, 1 for ICSSG1) */
    % let pruicss_instance = (instance.instance === "ICSSG1") ? 1 : 0;
    % /* Determine PRU slice (0 or 1) based on PRU assignment */
    % let pruicss_slice = 0;
    % if(instance.instance === "ICSSG1") {
    %     if(instance.PRU_ICSSG1_PRU && instance.PRU_ICSSG1_PRU.$solution && instance.PRU_ICSSG1_PRU.$solution.peripheralName.includes("PRU1")) {
    %         pruicss_slice = 1;
    %     }
    % } else {
    %     if(instance.PRU_ICSSG0_PRU && instance.PRU_ICSSG0_PRU.$solution && instance.PRU_ICSSG0_PRU.$solution.peripheralName.includes("PRU1")) {
    %         pruicss_slice = 1;
    %     }
    % }
    % /* Calculate channel mask */
    % let channel_mask = ((instance["Enable_Channel_0"] & 1) << 0) | ((instance["Enable_Channel_1"] & 1) << 1) | ((instance["Enable_Channel_2"] & 1) << 2) | ((instance["Enable_Channel_3"] & 1) << 3) | ((instance["Enable_Channel_4"] & 1) << 4) | ((instance["Enable_Channel_5"] & 1) << 5) | ((instance["Enable_Channel_6"] & 1) << 6) | ((instance["Enable_Channel_7"] & 1) << 7) | ((instance["Enable_Channel_8"] & 1) << 8);
    % /* Calculate PRU core enable mask */
    % let pru_core_mask;
    % if(instance["Enable_Load_Share"] == 0) {
    %     pru_core_mask = 1;  /* Single PRU mode - only PRU core (bit 0) */
    % } else {
    %     /* Load share: RTU_PRU (bit 1), PRU (bit 0), TX_PRU (bit 2) */
    %     pru_core_mask = ((instance["Enable_Channel_0"] || instance["Enable_Channel_1"] || instance["Enable_Channel_2"]) ? (1 << 1) : 0) | ((instance["Enable_Channel_3"] || instance["Enable_Channel_4"] || instance["Enable_Channel_5"]) ? (1 << 0) : 0) | ((instance["Enable_Channel_6"] || instance["Enable_Channel_7"] || instance["Enable_Channel_8"]) ? (1 << 2) : 0);
    % }
    {
        .instance = `i`U,
        .pruicss_instance = `pruicss_instance`U,
        .pruicss_slice = `pruicss_slice`U,
        .load_share_enabled = `(instance["Enable_Load_Share"] & 1)`U,
        .channel_mask = 0x`channel_mask.toString(16).toUpperCase()`U,
        .channel_enabled = {`instance["Enable_Channel_0"] & 1`, `instance["Enable_Channel_1"] & 1`, `instance["Enable_Channel_2"] & 1`, `instance["Enable_Channel_3"] & 1`, `instance["Enable_Channel_4"] & 1`, `instance["Enable_Channel_5"] & 1`, `instance["Enable_Channel_6"] & 1`, `instance["Enable_Channel_7"] & 1`, `instance["Enable_Channel_8"] & 1`},
        .core_clk_freq = `instance.pru.$name.toUpperCase()`_CORE_CLK_FREQ_HZ,
        .iep_clk_freq = `instance.pru.$name.toUpperCase()`_IEP_CLK_FREQ_HZ,
        .iep_reset_freq = `instance["IEP_Reset_Freq"]`U,
        .iep_instance = `instance["IEP_Instance"]`U,
        .sdfm_clock_source = `instance["SDFM_CLK_GEN"]`U,
        .sdfm_sampling_freq = `instance["SDFM_Clock_Value"]`U,
        .pru_core_mask = `pru_core_mask`U,
        .enable_epwm_sync = `(instance["Enable_Epwm_Sync"] & 1)`U,
%   if(instance["Enable_Epwm_Sync"]) {
        .epwm_sync_source = `instance["Epwm_Source"]`U,
%   } else {
        .epwm_sync_source = 0U,
%   }
        .pru_core_config = {
        /* PRU core (index 0 - channels 3-5 in load share, all channels in single PRU) */
        {
            .enable_trigger_mode = `instance["PRU_EnableTriggerMode"] & 1`,
            .en_double_nc_sampling = `instance["PRU_EnableDoubleUpdate"] & 1`,
%   if(instance["PRU_EnableTriggerMode"]) {
            .first_samp_trig_time = `instance["PRU_FirstTriggerPoint"]`,
%       if(instance["PRU_EnableDoubleUpdate"]) {
            .second_samp_trig_time = `instance["PRU_SecondTriggerPoint"]`,
%       } else {
            .second_samp_trig_time = 0,
%       }
            .iep_cmp_event = `instance["PRU_SelectIepCmpEvent"]`,
%   } else {
            .first_samp_trig_time = 0,
            .second_samp_trig_time = 0,
            .iep_cmp_event = 0,
%   }
            .enable_snoop_mode = `instance["PRU_EnableSnoopNC"] & 1`,
        },
%   if(instance["Enable_Load_Share"]) {
        /* RTU PRU core (index 1 - channels 0-2) */
        {
            .enable_trigger_mode = `instance["RTU_EnableTriggerMode"] & 1`,
            .en_double_nc_sampling = `instance["RTU_EnableDoubleUpdate"] & 1`,
%       if(instance["RTU_EnableTriggerMode"]) {
            .first_samp_trig_time = `instance["RTU_FirstTriggerPoint"]`,
%           if(instance["RTU_EnableDoubleUpdate"]) {
            .second_samp_trig_time = `instance["RTU_SecondTriggerPoint"]`,
%           } else {
            .second_samp_trig_time = 0,
%           }
            .iep_cmp_event = `instance["RTU_SelectIepCmpEvent"]`,
%       } else {
            .first_samp_trig_time = 0,
            .second_samp_trig_time = 0,
            .iep_cmp_event = 0,
%       }
            .enable_snoop_mode = `instance["RTU_EnableSnoopNC"] & 1`,
        },
        /* TX PRU core (index 2 - channels 6-8) */
        {
            .enable_trigger_mode = `instance["TXPRU_EnableTriggerMode"] & 1`,
            .en_double_nc_sampling = `instance["TXPRU_EnableDoubleUpdate"] & 1`,
%       if(instance["TXPRU_EnableTriggerMode"]) {
            .first_samp_trig_time = `instance["TXPRU_FirstTriggerPoint"]`,
%           if(instance["TXPRU_EnableDoubleUpdate"]) {
            .second_samp_trig_time = `instance["TXPRU_SecondTriggerPoint"]`,
%           } else {
            .second_samp_trig_time = 0,
%           }
            .iep_cmp_event = `instance["TXPRU_SelectIepCmpEvent"]`,
%       } else {
            .first_samp_trig_time = 0,
            .second_samp_trig_time = 0,
            .iep_cmp_event = 0,
%       }
            .enable_snoop_mode = `instance["TXPRU_EnableSnoopNC"] & 1`,
        },
%   } else {
        /* RTU PRU core - not used in single PRU mode */
        {
            .enable_trigger_mode = 0,
            .en_double_nc_sampling = 0,
            .first_samp_trig_time = 0,
            .second_samp_trig_time = 0,
            .iep_cmp_event = 0,
            .enable_snoop_mode = 0,
        },
        /* TX PRU core - not used in single PRU mode */
        {
            .enable_trigger_mode = 0,
            .en_double_nc_sampling = 0,
            .first_samp_trig_time = 0,
            .second_samp_trig_time = 0,
            .iep_cmp_event = 0,
            .enable_snoop_mode = 0,
        },
%   }
    },

    /* Channel configurations - all 9 channels (using flattened SDFM_ChannelAttrs) */
    .channels = {
%   for(let ch = 0; ch < 9; ch++) {
        /* Channel `ch` configuration */
        {
            .ch_id = `ch`,
            .enabled = `instance["Enable_Channel_" + ch.toString()] & 1`,
%       if(instance["Enable_Channel_" + ch.toString()]) {
            .filter_type = `instance["Ch" + ch.toString() + "_AccSource"]`,
            .normal_current_osr = `instance["Ch" + ch.toString() + "_NC_OSR"] - 1`,  /* Convert user OSR (4-256) to register value (3-255) */
            .over_current_osr = `instance["Ch" + ch.toString() + "_OC_OSR"] - 1`,  /* Convert user OSR (4-256) to register value (3-255) */
            .sdfm_clk = `instance["Ch" + ch.toString() + "_SDFM_Clock"]`,
            .enable_comparator = `instance["Ch" + ch.toString() + "_ComparatorEnable"] & 1`,
            .fd_enable = `instance["Ch" + ch.toString() + "_FastDetect"] & 1`,
%           if(instance["Ch" + ch.toString() + "_FastDetect"]) {
            .fd_window = `instance["Ch" + ch.toString() + "_FD_SIZE"]`,
            .fd_zero_max = `instance["Ch" + ch.toString() + "_ZeroMaxTh"]`,
            .fd_zero_min = `instance["Ch" + ch.toString() + "_ZeroMinTh"]`,
%           } else {
            .fd_window = 0,
            .fd_zero_max = 0,
            .fd_zero_min = 0,
%           }
            .clk_source = `instance["Ch" + ch.toString() + "_SDCLKSEL"]`,
            .clk_inv = `instance["Ch" + ch.toString() + "_CLKINV"] & 1`,
            /* Threshold fields - flattened (no nested threshold_config) */
%           if(instance["Ch" + ch.toString() + "_ComparatorEnable"]) {
            .high_threshold = `instance["Ch" + ch.toString() + "_HLT"]`,
            .low_threshold = `instance["Ch" + ch.toString() + "_LLT"]`,
%           } else {
            .high_threshold = 0,
            .low_threshold = 0,
%           }
%           if(instance["Ch" + ch.toString() + "_ZeroCross_Enable"]) {
            .en_zero_cross = 1,
            .zero_cross_threshold = `instance["Ch" + ch.toString() + "_ZCT"]`,
%           } else {
            .en_zero_cross = 0,
            .zero_cross_threshold = 0,
%           }
%       } else {
            .filter_type = 0,
            .normal_current_osr = 0,
            .over_current_osr = 0,
            .sdfm_clk = 0,
            .enable_comparator = 0,
            .fd_enable = 0,
            .fd_window = 0,
            .fd_zero_max = 0,
            .fd_zero_min = 0,
            .clk_source = 0,
            .clk_inv = 0,
            .high_threshold = 0,
            .low_threshold = 0,
            .en_zero_cross = 0,
            .zero_cross_threshold = 0,
%       }
        },
%   }
    },
    },
% }
};

/* SDFM priv objects - initialized by the driver */
static SDFM_Priv gSdfmPriv[CONFIG_SDFM_NUM_INSTANCES];

/* SDFM driver configuration */
SDFM_Config gSdfmHandle[CONFIG_SDFM_NUM_INSTANCES] =
{
% for(let i = 0; i < module.$instances.length; i++) {
    % let instance = module.$instances[i];
    {
        .priv = &gSdfmPriv[`instance.$name.toUpperCase()`],
        .attrs = &gSdfmAttrs[`instance.$name.toUpperCase()`],
    },
% }
};

uint32_t gSdfmConfigNum = CONFIG_SDFM_NUM_INSTANCES;

%}

